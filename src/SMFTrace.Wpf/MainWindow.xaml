<Window x:Class="SMFTrace.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SMFTrace.Wpf"
        xmlns:controls="clr-namespace:SMFTrace.Wpf.Controls"
        xmlns:converters="clr-namespace:SMFTrace.Wpf.Converters"
        xmlns:views="clr-namespace:SMFTrace.Wpf.Views"
        xmlns:vm="clr-namespace:SMFTrace.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="760" Width="1280"
        MinWidth="980" MinHeight="560"
        Background="{DynamicResource WindowBackgroundBrush}"
        Icon="Resources/app-icon.ico"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        AllowDrop="True"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <converters:RightInsetConverter x:Key="RightInsetConverter"/>

        <!-- Theme brushes (overridden at runtime by ApplyThemeResources) -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#15181D"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1B1F27"/>
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#262B36"/>
        <SolidColorBrush x:Key="ControlHoverBackgroundBrush" Color="#323845"/>
        <SolidColorBrush x:Key="ControlPressedBackgroundBrush" Color="#2F7FD8"/>
        <SolidColorBrush x:Key="ControlDisabledBackgroundBrush" Color="#1F232C"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#2E343F"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6E8EC"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#8A93A4"/>
        <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#10131A"/>
        <SolidColorBrush x:Key="SurfacePanelBrush" Color="#181C24"/>
        <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#262C38"/>
        <SolidColorBrush x:Key="TabItemBackgroundBrush" Color="#1B1F27"/>
        <SolidColorBrush x:Key="TabItemHoverBrush" Color="#222732"/>
        <SolidColorBrush x:Key="TabItemSelectedBrush" Color="#10131A"/>
        <SolidColorBrush x:Key="TabItemSelectedBorderBrush" Color="#2F7FD8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2F7FD8"/>
        <SolidColorBrush x:Key="TempoBadgeBrush" Color="#CC10131A"/>
        <SolidColorBrush x:Key="PlaylistRowBrush" Color="#181C24"/>
        <SolidColorBrush x:Key="PlaylistAltRowBrush" Color="#1B1F27"/>
        <SolidColorBrush x:Key="PlaylistHeaderBrush" Color="#1B1F27"/>
        <SolidColorBrush x:Key="PlaylistSelectionBrush" Color="#26456E"/>
        <SolidColorBrush x:Key="PlaylistNowPlayingGlyphBrush" Color="#5DA9FF"/>

        <!-- Ghost icon button -->
        <Style x:Key="GhostIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary (filled accent) - used for Play -->
        <Style x:Key="PrimaryIconButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostIconButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3F8FE8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2670C0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlDisabledBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle button (ghost with accent when checked) -->
        <Style x:Key="GhostIconToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill toggle (text + selected accent) for the Piano Roll sub-toolbar -->
        <Style x:Key="PillToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Track Mute/Solo small toggle -->
        <Style x:Key="TrackToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniZoomButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostIconButtonStyle}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          IsEnabled="{TemplateBinding IsEnabled}"
                                          FocusVisualStyle="{x:Null}"
                                          Focusable="False"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="8,0,4,0"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    <Path Grid.Column="1"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 8 0 L 4 5 Z"
                                          Fill="{DynamicResource TextMutedBrush}"/>
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource ControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <ScrollViewer Margin="2"
                                                  CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab control / items -->
        <Style TargetType="TabControl" x:Key="DarkTabControlStyle">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TabItem" x:Key="DarkTabItemStyle">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <Border x:Name="Indicator"
                                    Height="2"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource AccentBrush}"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabItemHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="10,0"/>
        </Style>

        <Style x:Key="StatusSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBorderBrush}"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>

        <Style x:Key="TimeReadoutStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="TempoSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20">
                            <Border Height="3"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    CornerRadius="2"/>
                            <Track x:Name="PART_Track" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{x:Null}" IsHitTestVisible="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{x:Null}" IsHitTestVisible="False" Background="Transparent">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource TextPrimaryBrush}"
                                                         Stroke="{DynamicResource AccentBrush}"
                                                         StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeekSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="14">
                            <Border Height="4"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ControlBackgroundBrush}"
                                    CornerRadius="2"/>
                            <Track x:Name="PART_Track" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{x:Null}" IsHitTestVisible="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{x:Null}" IsHitTestVisible="False" Background="Transparent" Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White"
                                                         Stroke="{DynamicResource AccentBrush}"
                                                         StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarDividerStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBorderBrush}"/>
            <Setter Property="Margin" Value="6,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =================== PRIMARY TOOLBAR =================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: File + Transport + Time + Tempo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenCommand}" Style="{StaticResource GhostIconButtonStyle}" ToolTip="{Binding OpenToolTip}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE8E5;"/>
                    </Button>
                    <Button Command="{Binding AddFilesCommand}" Style="{StaticResource GhostIconButtonStyle}" ToolTip="{Binding AddToPlaylistToolTip}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE710;"/>
                    </Button>

                    <Border Style="{StaticResource ToolbarDividerStyle}"/>

                    <Button Command="{Binding PreviousCommand}"
                            Style="{StaticResource GhostIconButtonStyle}"
                            ToolTip="{Binding PreviousToolTip}"
                            Visibility="{Binding ShowPlaylistNavigation, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE892;"/>
                    </Button>
                    <Button Command="{Binding PlayCommand}"
                            Style="{StaticResource PrimaryIconButtonStyle}"
                            ToolTip="{Binding PlayToolTip}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE768;"/>
                    </Button>
                    <Button Command="{Binding PauseCommand}"
                            Style="{StaticResource GhostIconButtonStyle}"
                            ToolTip="{Binding PauseToolTip}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE769;"/>
                    </Button>
                    <Button Command="{Binding StopCommand}"
                            Style="{StaticResource GhostIconButtonStyle}"
                            ToolTip="{Binding StopToolTip}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE71A;"/>
                    </Button>
                    <Button Command="{Binding NextCommand}"
                            Style="{StaticResource GhostIconButtonStyle}"
                            ToolTip="{Binding NextToolTip}"
                            Visibility="{Binding ShowPlaylistNavigation, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE893;"/>
                    </Button>
                    <ToggleButton IsChecked="{Binding LoopPlayback}"
                                  Style="{StaticResource GhostIconToggleStyle}"
                                  ToolTip="{Binding LoopPlaybackToolTip}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE8EE;"/>
                    </ToggleButton>

                    <Border Style="{StaticResource ToolbarDividerStyle}"/>

                    <TextBlock Style="{StaticResource TimeReadoutStyle}"
                               Margin="4,0,0,0"
                               Text="{Binding CurrentTime, StringFormat='{}{0:mm\\:ss\\.fff}'}"
                               ToolTip="Current playback position"/>
                    <TextBlock Style="{StaticResource TimeReadoutStyle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text=" / "/>
                    <TextBlock Style="{StaticResource TimeReadoutStyle}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="{Binding TotalDuration, StringFormat='{}{0:mm\\:ss\\.fff}'}"
                               ToolTip="Total duration"/>

                    <Border Style="{StaticResource ToolbarDividerStyle}"/>

                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               Margin="0,0,6,0"
                               Text="TEMPO"/>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontFamily="Consolas"
                               FontSize="14"
                               FontWeight="SemiBold"
                               MinWidth="62"
                               TextAlignment="Right"
                               Text="{Binding EffectiveTempo, StringFormat={}{0:F1}}"
                               ToolTip="Effective tempo (file tempo + adjustment)"/>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               Margin="2,0,8,0"
                               Text="BPM"/>
                    <Slider Minimum="{Binding MinTempoAdjustmentBpm}"
                            Maximum="{Binding MaxTempoAdjustmentBpm}"
                            Value="{Binding TempoAdjustmentBpm, Mode=TwoWay}"
                            Width="120"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            SmallChange="1"
                            LargeChange="5"
                            AutoToolTipPlacement="TopLeft"
                            AutoToolTipPrecision="0"
                            Style="{StaticResource TempoSliderStyle}"
                            ToolTip="Tempo adjustment (BPM)"
                            PreviewMouseLeftButtonDown="TempoAdjustmentSlider_PreviewMouseLeftButtonDown"/>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontFamily="Consolas"
                               FontSize="11"
                               Margin="6,0,0,0"
                               MinWidth="56"
                               Text="{Binding TempoAdjustmentLabel}"/>
                </StackPanel>

                <!-- RIGHT: Output + Program + Theme + Panic -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               Margin="0,0,6,0"
                               Text="OUTPUT"/>
                    <ComboBox ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="Name"
                              Width="180"
                              ToolTip="MIDI output device"
                              Style="{StaticResource DarkComboBoxStyle}"/>

                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               Margin="12,0,6,0"
                               Text="PROGRAM"/>
                    <ComboBox ItemsSource="{Binding DefaultInstruments}"
                              SelectedItem="{Binding SelectedDefaultInstrument}"
                              DisplayMemberPath="Name"
                              Width="160"
                              ToolTip="Preview / default instrument (used when file has no program changes)"
                              Style="{StaticResource DarkComboBoxStyle}"/>

                    <Border Style="{StaticResource ToolbarDividerStyle}"/>

                    <ToggleButton IsChecked="{Binding IsDarkTheme}"
                                  Style="{StaticResource GhostIconToggleStyle}"
                                  ToolTip="{Binding ThemeToggleToolTip}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="{Binding ThemeIconGlyph}"/>
                    </ToggleButton>
                    <Button Command="{Binding PanicCommand}"
                            Style="{StaticResource GhostIconButtonStyle}"
                            ToolTip="{Binding PanicToolTip}"
                            Foreground="#E5484D">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE7E4;"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =================== TAB CONTROL =================== -->
        <TabControl x:Name="MainTabs"
                    Grid.Row="1"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    Style="{StaticResource DarkTabControlStyle}"
                    ItemContainerStyle="{StaticResource DarkTabItemStyle}">
            <!-- ===== Piano Roll ===== -->
            <TabItem Header="Piano Roll">
                <Grid Background="{DynamicResource SurfaceBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource SurfacePanelBrush}"
                            BorderBrush="{DynamicResource SurfaceBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,6">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <ToggleButton Content="Tracks" IsChecked="{Binding ShowTrackControls}" Style="{StaticResource PillToggleStyle}" ToolTip="Show track mute / solo sidebar (Ctrl+M)"/>
                                <ToggleButton Content="Compact" IsChecked="{Binding CompactPitchRange}" Style="{StaticResource PillToggleStyle}" ToolTip="{Binding CompactPitchRangeToolTip}"/>
                                <ToggleButton Content="Overlay" IsChecked="{Binding OverlayMode}" Style="{StaticResource PillToggleStyle}" ToolTip="{Binding OverlayModeToolTip}"/>
                                <ToggleButton Content="Grid" IsChecked="{Binding ShowBarsBeatsGrid}" Style="{StaticResource PillToggleStyle}" ToolTip="{Binding ShowBarsBeatsGridToolTip}"/>
                                <ToggleButton Content="Notes" IsChecked="{Binding ShowNoteNames}" Style="{StaticResource PillToggleStyle}" ToolTip="{Binding ShowNoteNamesToolTip}"/>
                                <ToggleButton Content="Keys" IsChecked="{Binding ShowPianoKeys}" Style="{StaticResource PillToggleStyle}" ToolTip="{Binding ShowPianoKeysToolTip}"/>
                                <ToggleButton Content="Tempo" IsChecked="{Binding ShowTempo}" Style="{StaticResource PillToggleStyle}" ToolTip="{Binding ShowTempoToolTip}"/>
                                <ToggleButton Content="Lyrics"
                                              IsChecked="{Binding ShowLyricsLane}"
                                              Style="{StaticResource PillToggleStyle}"
                                              ToolTip="{Binding ShowLyricsLaneToolTip}"
                                              Visibility="{Binding HasLyrics, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="0,0,6,0"
                                           Text="ZOOM"/>
                                <Button Content="−" Command="{Binding ZoomOutCommand}" Style="{StaticResource MiniZoomButtonStyle}" ToolTip="Zoom out"/>
                                <Button Content="+" Command="{Binding ZoomInCommand}" Style="{StaticResource MiniZoomButtonStyle}" ToolTip="Zoom in"/>
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           Margin="10,0,6,0"
                                           Text="LANE"/>
                                <Button Content="−" Command="{Binding VerticalZoomOutCommand}" Style="{StaticResource MiniZoomButtonStyle}" ToolTip="Decrease lane height"/>
                                <Button Content="+" Command="{Binding VerticalZoomInCommand}" Style="{StaticResource MiniZoomButtonStyle}" ToolTip="Increase lane height"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="220"
                                Background="{DynamicResource SurfacePanelBrush}"
                                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                BorderThickness="0,0,1,0"
                                Visibility="{Binding ShowTrackControls, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top"
                                        Background="{DynamicResource PanelBackgroundBrush}"
                                        BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,8">
                                    <TextBlock Text="TRACKS"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding TrackPlaybackStates}" Margin="0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="10,3" Height="28">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontSize="12"
                                                               Margin="0,0,6,0"/>
                                                    <ToggleButton Grid.Column="1"
                                                                  Content="M"
                                                                  ToolTip="Mute this track"
                                                                  IsChecked="{Binding IsMuted}"
                                                                  Style="{StaticResource TrackToggleButtonStyle}"/>
                                                    <ToggleButton Grid.Column="2"
                                                                  Content="S"
                                                                  ToolTip="Solo this track"
                                                                  IsChecked="{Binding IsSolo}"
                                                                  Style="{StaticResource TrackToggleButtonStyle}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Column="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <controls:PianoRollPanel x:Name="PianoRoll"
                                                         CurrentTime="{Binding CurrentTime}"
                                                         TotalDuration="{Binding TotalDuration}"
                                                         WindowSeconds="{Binding WindowSeconds, Mode=TwoWay}"
                                                         PitchRowHeight="{Binding PitchRowHeight}"
                                                         MidiFormat="{Binding MidiFormat}"
                                                         ShowTempo="{Binding ShowTempo}"
                                                         RenderTempoBadge="False"
                                                         ShowOverlayTrackLegend="False"
                                                         ShowBarsBeatsGrid="{Binding ShowBarsBeatsGrid}"
                                                         ShowNoteNames="{Binding ShowNoteNames}"
                                                         ShowPianoKeys="{Binding ShowPianoKeys}"
                                                         CompactPitchRange="{Binding CompactPitchRange}"
                                                         OverlayMode="{Binding OverlayMode}"
                                                         IsDarkTheme="{Binding IsDarkTheme}"
                                                         IsPlaying="{Binding IsPlaying}"
                                                         ShowLyricsLane="{Binding ShowLyricsLane}"
                                                         Lyrics="{Binding Lyrics}"
                                                         TrackPlaybackStates="{Binding TrackPlaybackStates}"
                                                         TempoBadgeRightInset="14"/>
                            </ScrollViewer>

                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Panel.ZIndex="6"
                                    Margin="0,10,14,0"
                                    Background="{DynamicResource TempoBadgeBrush}"
                                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,4"
                                    Visibility="{Binding ShowTempo, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontFamily="Consolas"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="{Binding EffectiveTempo, StringFormat={}{0:F1}}"/>
                                    <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               Text="BPM"/>
                                </StackPanel>
                            </Border>

                            <!-- Empty state overlay -->
                            <Border Background="{DynamicResource SurfaceBackgroundBrush}"
                                    Visibility="{Binding IsFileLoaded, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="56"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="&#xEC4F;"
                                               Margin="0,0,0,16"/>
                                    <TextBlock Text="No file loaded"
                                               HorizontalAlignment="Center"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Drop a .mid file here, or open one to begin."
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="13"
                                               Margin="0,6,0,18"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Open file…"
                                                Command="{Binding OpenCommand}"
                                                Padding="14,6"
                                                Background="{DynamicResource AccentBrush}"
                                                Foreground="White"
                                                BorderThickness="0"
                                                FontSize="13"
                                                Cursor="Hand"/>
                                        <Button Content="Add to playlist…"
                                                Command="{Binding AddFilesCommand}"
                                                Padding="14,6"
                                                Margin="8,0,0,0"
                                                Background="Transparent"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1"
                                                FontSize="13"
                                                Cursor="Hand"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===== Playlist ===== -->
            <TabItem Header="Playlist">
                <DataGrid x:Name="PlaylistGrid"
                          ItemsSource="{Binding PlaylistEntries}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="True"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="{DynamicResource SurfaceBackgroundBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          RowBackground="{DynamicResource PlaylistRowBrush}"
                          AlternatingRowBackground="{DynamicResource PlaylistAltRowBrush}"
                          BorderThickness="0"
                          EnableRowVirtualization="True"
                          MouseDoubleClick="PlaylistGrid_MouseDoubleClick">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource PlaylistHeaderBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PlaylistSelectionBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PlaylistSelectionBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PlaylistSelectionBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PlaylistSelectionBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="28">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="{DynamicResource PlaylistNowPlayingGlyphBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value=""/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                                                        <Setter Property="Text" Value="&#xE768;"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Title" Binding="{Binding DisplayTitle}" Width="2*"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="Auto"/>
                        <DataGridTextColumn Header="Tempo" Binding="{Binding TempoDisplay}" Width="Auto"/>
                        <DataGridTextColumn Header="Time Sig" Binding="{Binding TimeSignatureDisplay}" Width="Auto"/>
                        <DataGridTextColumn Header="Key" Binding="{Binding KeySignatureDisplay}" Width="Auto"/>
                        <DataGridTextColumn Header="SMF" Binding="{Binding SmfTypeDisplay}" Width="Auto"/>
                        <DataGridTextColumn Header="Tracks" Binding="{Binding TrackCount}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="SysEx" Binding="{Binding SysExPresentDisplay}" Width="Auto"/>
                        <DataGridTextColumn Header="Lyrics" Binding="{Binding LyricsPresentDisplay}" Width="Auto"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ===== Events ===== -->
            <TabItem Header="Events">
                <views:DiagnosticsView x:Name="DiagnosticsView"
                                       DataContext="{Binding Diagnostics}"/>
            </TabItem>
        </TabControl>

        <!-- =================== SEEK BAR =================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,8,14,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding CurrentTime, StringFormat='{}{0:mm\\:ss\\.fff}'}"
                           Style="{StaticResource TimeReadoutStyle}"
                           Margin="0,0,12,0"/>
                <Slider x:Name="SeekSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="1"
                        Value="{Binding SeekPosition, Mode=TwoWay}"
                        Style="{StaticResource SeekSliderStyle}"
                        Thumb.DragStarted="SeekSlider_DragStarted"
                        Thumb.DragCompleted="SeekSlider_DragCompleted"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding TotalDuration, StringFormat='{}{0:mm\\:ss\\.fff}'}"
                           Style="{StaticResource TimeReadoutStyle}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- =================== STATUS BAR =================== -->
        <Border Grid.Row="3"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,1,0,0"
                Height="26">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="#46A758"/>
                    <TextBlock Style="{StaticResource StatusTextStyle}"
                               Margin="6,0,0,0"
                               Text="{Binding OutputDeviceStatusLabel}"
                               ToolTip="MIDI output device"/>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource StatusSeparatorStyle}"/>

                <TextBlock Grid.Column="2"
                           Style="{StaticResource StatusTextStyle}"
                           Text="{Binding FileStatusLine}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <ToggleButton Grid.Column="3"
                              IsChecked="{Binding DisableSysExOutput}"
                              ToolTip="{Binding SysExStatusToolTip}"
                              Background="Transparent"
                              BorderThickness="0"
                              Cursor="Hand"
                              FocusVisualStyle="{x:Null}"
                              Padding="10,2"
                              VerticalAlignment="Stretch">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <TextBlock x:Name="T"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{Binding SysExStatusLabel}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="T" Property="Foreground" Value="#F5A524"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <Border Grid.Column="4" Style="{StaticResource StatusSeparatorStyle}"/>
                <TextBlock Grid.Column="5"
                           Style="{StaticResource StatusTextStyle}"
                           Margin="14,0,12,0"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                           Text="Parsing…"/>
            </Grid>
        </Border>
    </Grid>
</Window>
